# ── Kafka (Redpanda) ─────────────────────────────────────────────
KAFKA_BOOTSTRAP=localhost:19092
KAFKA_BOOTSTRAP_INTERNAL=redpanda:9092
TOPIC_LISTINGS_RAW=realestate.listings.raw
TOPIC_LISTINGS_CLEAN=realestate.listings.clean
TOPIC_ALERTS=realestate.alerts

# ── HDFS ─────────────────────────────────────────────────────────
HDFS_NAMENODE=hdfs://namenode:8020
HDFS_BRONZE=/lake/bronze/listings
HDFS_SILVER=/lake/silver/listings
HDFS_GOLD=/lake/gold

# ── PostgreSQL (serving layer) ───────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=realestate
POSTGRES_USER=reuser
POSTGRES_PASSWORD=repass

# ── Redis (hot path speed view) ──────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL_SECONDS=900

# ── MinIO (chỉ dùng làm artifact store cho MLflow) ────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_ARTIFACT_BUCKET=mlflow

# ── MLflow ───────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
# Mô hình mà api-ml nạp lúc khởi động. Đổi sang models:/housing-price-model/Production
# khi đã gán stage trong Model Registry.
MODEL_URI=models:/housing-price-model/latest
# MAPE đo trên tập kiểm tra, dùng để dựng khoảng giá trả về cho người dùng.
MODEL_MAPE=19.6

# ── Tầng ứng dụng ────────────────────────────────────────────────
APP_MLAPI_BASEURL=http://api-ml:8000

# ── Crawler ──────────────────────────────────────────────────────
CRAWL_DELAY_SECONDS=20
# Điền email thật của bạn vào .env (file đó KHÔNG commit). Địa chỉ liên hệ
# trong User-Agent là yêu cầu đạo đức khi crawl — để chủ site báo cho bạn
# nếu crawler gây phiền, thay vì chặn thẳng IP.
CRAWL_USER_AGENT=UIT-IE221-Academic-Crawler/1.0 (do an hoc thuat; lien he: your-email@example.com)

# ── Đường dẫn trong container ────────────────────────────────────
# Bắt buộc: Spark executor không suy được đường dẫn từ __file__
ADMIN_UNITS_PATH=/app/data/geo/admin_units.json
SPARK_MASTER_URL=spark://spark-master:7077
WARD2025_BRIDGE_PATH=/app/data/geo/ward2025_to_old.json
